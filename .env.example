# =====================================================
# BAUST AI HELPDESK & KNOWLEDGE PORTAL - ENVIRONMENT TEMPLATE
# Copy this file to .env and replace with your actual keys
# =====================================================

# Google Gemini API Key (Mandatory)
# Obtain a free or paid API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OCR.space API Key (For scanned documents and photos)
# Free tier key available at: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Flask Session Encryption Secret Key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_secret_key_here

# System Configuration (Optional)
GEMINI_MODEL=gemini-flash-latest
PORT=5000

